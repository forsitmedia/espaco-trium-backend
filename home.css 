/* Background Video Styling */
#bg-video {
  position: fixed;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: auto;
  height: 100vh;
  object-fit: cover;
  z-index: -1;
}

/* Make it adjust on landscape devices */
@media (orientation: landscape) {
  #bg-video {
    width: 100vw;
    height: auto;
  }
}

/* Ensure content sits above video */
.hero-text,
.intro,
footer,
.navbar {
  position: relative;
  z-index: 1;
  color: white;
}

.hero-text {
  padding: 20vh 2rem 2rem 2rem;
  text-align: center;
  font-size: 1.5rem;
}

.intro {
  padding: 2rem;
  background: rgba(0, 0, 0, 0.5);
  margin: 0 1rem;
  border-radius: 12px;
}

footer {
  background: rgba(0, 0, 0, 0.7);
  text-align: center;
  padding: 1rem 0;
  font-size: 0.9rem;
  color: white;
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(0, 0, 0, 0.7);
  padding: 1rem 2rem;
  position: relative;
  z-index: 2;
}

.navbar ul {
  display: flex;
  list-style: none;
  gap: 1rem;
  margin: 0;
  padding: 0;
}

.navbar a {
  text-decoration: none;
  color: white;
  font-weight: bold;
}

.navbar a.active {
  color: #f39c12;
}
